---
import Layout from '../layouts/Layout.astro';
import RuleBox from "../components/RuleBox.astro"
---

<Layout>
	<main>
		<h1>Robin's Rules</h1>
		<RuleBox />
	</main>
	
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		flex-grow: 1;
		padding: 0.5rem;
	}

	h1 {
		font-size: 3rem;
		font-weight: 400;
		margin: 1.5rem;
		text-align: center;
	}
</style>