---
import '@fontsource-variable/work-sans';
import "../assets/base.css";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Robin's Rules</title>
	</head>
	<body>
		<slot />
		<footer>
		<p>
			Built by <a href="https://github.com/nozxmc">nozx</a> with love.
			Licensed under the <a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPLv3</a>.
			Open-<a href="https://github.com/nozxmc/robinsrules">source</a>.
		</p>
	</footer>
	</body>
</html>

<style>
	html,
	body {
		width: 100%;
		height: 100%;

		background-color: oklch(0.15 0 0);
		color: oklch(0.95 0 0);
	}

	body {
		display: flex;
		flex-direction: column;
	}

	footer {
		display: flex;
		justify-content: center;

		transition: opacity 100ms ease-out;
		opacity: 50%;
		&:hover, &:focus-within {
			opacity: 100%;
		}
		
		p {
			display: block;
			margin: 1rem;
		}
	}
</style>
